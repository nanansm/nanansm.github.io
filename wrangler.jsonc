{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanansm-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "account_id": "5a4728efc7ef4e9ef576ba275d74fee0",
  "routes": [{ "pattern": "nanan.motekreatif.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "HITS", "id": "d3bff9d7be9e44bd982747021262904b" },
    { "binding": "CONTACT", "id": "a38760ab2c2c4af0b75460dd51871335" }
  ],
  "send_email": [{ "name": "EMAIL", "destination_address": "smnanan@gmail.com" }],
  // Sitekey publik. Build produksi pakai `npm run deploy` supaya ContactBlock ikut sitekey ini;
  // `npm run build` biasa tetap pakai test sitekey (dipakai e2e). TURNSTILE_SECRET = wrangler secret.
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAFa9L__lEUjQoof1",
    "CONTACT_TO": "smnanan@gmail.com"
  }
}
