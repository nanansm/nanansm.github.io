---
import { site } from '../data/site';

interface Props {
  lockSkin?: 'manual' | 'tv' | 'handheld' | undefined;
}

const { lockSkin } = Astro.props;
const names = site.boot.skinNames;
const current = lockSkin ?? 'manual';
const switchAria = `${site.boot.switchLabel}: ${names[current]}`;
---

<div
  class="skin-controls"
  data-skin-controls
  data-names={JSON.stringify(names)}
  data-switch-label={site.boot.switchLabel}
>
  {
    lockSkin ? (
      <a class="btn" href="/" aria-label={switchAria}>
        {site.boot.switchLabel}
      </a>
    ) : (
      <button type="button" class="btn" data-skin-switch aria-label={switchAria}>
        {site.boot.switchLabel}
      </button>
    )
  }
</div>

<script>
  type Skin = 'tv' | 'handheld' | 'manual';

  const NEXT: Record<Skin, Skin> = { tv: 'handheld', handheld: 'manual', manual: 'tv' };

  function isSkin(v: string | undefined | null): v is Skin {
    return v === 'tv' || v === 'handheld' || v === 'manual';
  }

  const box = document.querySelector<HTMLElement>('[data-skin-controls]');
  if (box) {
    const names = JSON.parse(box.dataset.names ?? '{}') as Record<Skin, string>;
    const label = box.dataset.switchLabel ?? '';
    const switchBtn = box.querySelector<HTMLButtonElement>('[data-skin-switch]');

    if (switchBtn) {
      switchBtn.addEventListener('click', () => {
        const cur = document.documentElement.dataset.skin;
        const next = NEXT[isSkin(cur) ? cur : 'manual'];
        document.documentElement.dataset.skin = next;
        switchBtn.setAttribute('aria-label', `${label}: ${names[next]}`);
        try {
          window.localStorage.setItem('skin', next);
        } catch {
          /* storage blocked */
        }
        try {
          const url = new URL(window.location.href);
          // ?skin dibuang: link yang disalin tidak memaksa skin ke perangkat lain, pilihan tetap di localStorage
          url.searchParams.delete('skin');
          window.history.replaceState(null, '', url.toString());
        } catch {
          /* history blocked */
        }
        window.dispatchEvent(new CustomEvent<Skin>('skinchange', { detail: next }));
      });

      const active = document.documentElement.dataset.skin;
      if (isSkin(active)) switchBtn.setAttribute('aria-label', `${label}: ${names[active]}`);
    }
  }
</script>
