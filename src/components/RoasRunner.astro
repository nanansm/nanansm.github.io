---
import { site } from '../data/site';
---

<dialog class="rr" aria-labelledby="rr-title">
  <div class="rr__body">
    <h2 id="rr-title" class="rr__title">ROAS RUNNER</h2>
    <p class="rr__score">
      <span>{site.ui.hud.highScore}: <span data-rr-high>0</span></span>
      <span data-rr-score>0</span>
    </p>
    <canvas class="rr__canvas" width="320" height="180" aria-label="ROAS RUNNER"></canvas>
    <p class="rr__hint">{site.boot.pressStart}</p>
    <button type="button" class="rr__back" data-rr-close>{site.ui.hud.back}</button>
  </div>
</dialog>

<script>
  import { play } from '../scripts/sfx';
  import { site } from '../data/site';

  const KEY = 'roasRunnerHigh';
  const W = 320;
  const H = 180;
  const GROUND = 150;
  const PX = 32;
  const SIZE = 16;
  const GRAVITY = 900;
  const JUMP_V = -330;

  type Mode = 'idle' | 'run' | 'over';
  interface Obstacle {
    x: number;
    w: number;
    h: number;
  }
  interface Coin {
    x: number;
    y: number;
  }

  const dialog = document.querySelector<HTMLDialogElement>('dialog.rr');
  const canvas = dialog?.querySelector<HTMLCanvasElement>('canvas.rr__canvas') ?? null;
  const ctx = canvas?.getContext('2d') ?? null;
  const scoreEl = dialog?.querySelector<HTMLElement>('[data-rr-score]') ?? null;
  const highEl = dialog?.querySelector<HTMLElement>('[data-rr-high]') ?? null;
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('[data-rr-close]') ?? null;

  if (dialog && canvas && ctx && scoreEl && highEl && closeBtn) {
    let mode: Mode = 'idle';
    let raf = 0;
    let last = 0;
    let y = GROUND - SIZE;
    let vy = 0;
    let speed = 110;
    let dist = 0;
    let coins = 0;
    let frame = 0;
    let nextGap = 0;
    let obstacles: Obstacle[] = [];
    let pickups: Coin[] = [];
    let high = 0;
    let trigger: HTMLElement | null = null;

    const readHigh = (): number => {
      try {
        const n = Number.parseInt(localStorage.getItem(KEY) ?? '0', 10);
        return Number.isFinite(n) && n > 0 ? n : 0;
      } catch {
        return 0;
      }
    };
    const writeHigh = (n: number): void => {
      try {
        localStorage.setItem(KEY, String(n));
      } catch {
        // storage unavailable
      }
    };

    const score = (): number => Math.floor(dist / 10) + coins * 10;
    const rand = (a: number, b: number): number => a + Math.random() * (b - a);

    const reset = (): void => {
      y = GROUND - SIZE;
      vy = 0;
      speed = 110;
      dist = 0;
      coins = 0;
      frame = 0;
      nextGap = 0;
      obstacles = [];
      pickups = [];
      scoreEl.textContent = '0';
    };

    const spawn = (): void => {
      const w = Math.round(rand(12, 24));
      const h = Math.round(rand(12, 28));
      obstacles.push({ x: W + 8, w, h });
      if (Math.random() < 0.6) {
        pickups.push({ x: W + 8 + w / 2 - 4, y: GROUND - rand(46, 66) });
      }
      nextGap = speed * rand(0.85, 1.4) + w;
    };

    const text = (s: string, cy: number, color: string): void => {
      ctx.font = '12px "Press Start 2P", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = color;
      ctx.fillText(s, W / 2, cy);
    };

    const draw = (): void => {
      ctx.fillStyle = '#9FD3E8';
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = '#F7EED6';
      ctx.fillRect(0, GROUND, W, H - GROUND);
      ctx.fillStyle = '#1A1622';
      ctx.fillRect(0, GROUND, W, 3);
      ctx.fillStyle = '#C84C0C';
      for (const o of obstacles) ctx.fillRect(Math.round(o.x), GROUND - o.h, o.w, o.h);
      ctx.fillStyle = '#F0A800';
      for (const c of pickups) {
        ctx.fillRect(Math.round(c.x) + 1, Math.round(c.y), 6, 8);
        ctx.fillRect(Math.round(c.x), Math.round(c.y) + 1, 8, 6);
      }
      const py = Math.round(y);
      ctx.fillStyle = '#1A1622';
      ctx.fillRect(PX + 7, py - 4, 2, 4);
      ctx.fillRect(PX, py, SIZE, SIZE);
      ctx.fillStyle = '#2A7F9E';
      ctx.fillRect(PX + 1, py + 1, SIZE - 2, SIZE - 2);
      ctx.fillStyle = '#F7EED6';
      ctx.fillRect(PX + 9, py + 4, 4, 4);
      ctx.fillStyle = '#1A1622';
      ctx.fillRect(PX + 11, py + 5, 2, 3);
      const onGround = y >= GROUND - SIZE;
      const step = onGround && Math.floor(frame / 6) % 2 === 0;
      ctx.fillRect(PX + (step ? 2 : 8), py + SIZE, 5, 2);
      if (mode === 'idle') {
        text(site.boot.pressStart, 60, '#1A1622');
      } else if (mode === 'over') {
        text(String(score()), 50, '#1A1622');
        text(site.boot.pressStart, 76, '#1A1622');
      }
    };

    const gameOver = (): void => {
      mode = 'over';
      const s = score();
      if (s > high) {
        high = s;
        writeHigh(high);
        highEl.textContent = String(high);
      }
      scoreEl.textContent = String(s);
      draw();
    };

    const hits = (o: Obstacle): boolean =>
      PX + 2 < o.x + o.w && PX + SIZE - 2 > o.x && y + 2 < GROUND && y + SIZE - 1 > GROUND - o.h;

    const tick = (now: number): void => {
      raf = 0;
      if (!dialog.open || mode !== 'run') return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      frame += 1;
      speed = Math.min(260, speed + 4 * dt);
      vy += GRAVITY * dt;
      y = Math.min(GROUND - SIZE, y + vy * dt);
      if (y >= GROUND - SIZE) vy = 0;
      const dx = speed * dt;
      dist += dx;
      for (const o of obstacles) o.x -= dx;
      for (const c of pickups) c.x -= dx;
      obstacles = obstacles.filter((o) => o.x + o.w > -4);
      const lastObs = obstacles[obstacles.length - 1];
      if (!lastObs || W - (lastObs.x + lastObs.w) >= nextGap) spawn();
      pickups = pickups.filter((c) => {
        const got = PX + SIZE > c.x && PX < c.x + 8 && y + SIZE > c.y && y < c.y + 8;
        if (got) {
          coins += 1;
          play('coin');
        }
        return !got && c.x > -8;
      });
      scoreEl.textContent = String(score());
      if (obstacles.some(hits)) {
        gameOver();
        return;
      }
      draw();
      raf = requestAnimationFrame(tick);
    };

    const start = (): void => {
      reset();
      mode = 'run';
      play('start');
      last = performance.now();
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    };

    const jump = (): void => {
      if (y >= GROUND - SIZE) {
        vy = JUMP_V;
        play('jump');
      }
    };

    const action = (): void => {
      if (mode === 'run') jump();
      else start();
    };

    const open = (from: HTMLElement | null): void => {
      if (dialog.open) return;
      trigger = from;
      high = readHigh();
      highEl.textContent = String(high);
      reset();
      mode = 'idle';
      dialog.showModal();
      draw();
    };

    document.addEventListener('click', (e) => {
      const t = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-open-runner]') : null;
      if (t) open(t);
    });
    window.addEventListener('roasrunner:open', () => {
      const a = document.activeElement;
      open(a instanceof HTMLElement ? a : null);
    });

    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      cancelAnimationFrame(raf);
      raf = 0;
      reset();
      mode = 'idle';
      trigger?.focus();
      trigger = null;
    });

    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      action();
    });
    dialog.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      const jumpKey = e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW';
      const onBtn = e.target === closeBtn;
      if (jumpKey && !onBtn) {
        e.preventDefault();
        if (!e.repeat) action();
      } else if (e.code === 'Enter' && !onBtn && mode !== 'run') {
        e.preventDefault();
        start();
      }
    });

    void document.fonts?.ready.then(() => {
      if (dialog.open && mode !== 'run') draw();
    });
  }
</script>

<style>
  .rr {
    box-sizing: border-box;
    width: min(92vw, 680px);
    max-height: 92vh;
    padding: 0;
    overflow: auto;
    color: #1a1622;
    background: #f7eed6;
    border: 4px solid #1a1622;
    border-radius: 0;
    box-shadow: 8px 8px 0 #1a1622;
  }

  .rr::backdrop {
    background: rgb(26 22 34 / 85%);
  }

  .rr__body {
    display: grid;
    gap: 12px;
    justify-items: center;
    padding: 16px;
  }

  .rr__title {
    margin: 0;
    font-family: "Press Start 2P", monospace;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  .rr__score {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: min(100%, 640px);
    margin: 0;
    font-family: "Press Start 2P", monospace;
    font-size: 12px;
    line-height: 1.4;
  }

  .rr__canvas {
    display: block;
    width: min(100%, 640px);
    aspect-ratio: 16 / 9;
    touch-action: none;
    cursor: pointer;
    image-rendering: pixelated;
    border: 4px solid #1a1622;
  }

  .rr__hint {
    margin: 0;
    font-family: "Press Start 2P", monospace;
    font-size: 12px;
    text-align: center;
  }

  .rr__back {
    min-width: 120px;
    min-height: 44px;
    padding: 8px 16px;
    font-family: "Silkscreen", monospace;
    font-size: 14px;
    color: #f7eed6;
    cursor: pointer;
    background: #c84c0c;
    border: 4px solid #1a1622;
    border-radius: 0;
    box-shadow: 4px 4px 0 #1a1622;
  }

  .rr__back:focus-visible,
  .rr__canvas:focus-visible {
    outline: 3px solid #f0a800;
    outline-offset: 2px;
  }
</style>
